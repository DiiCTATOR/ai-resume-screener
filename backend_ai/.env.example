# Server Port
PORT=4000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/resume_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai_resume_mern

# Cohere API Key (Get from https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your_cohere_api_key_here

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173
